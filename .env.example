# Salin ke .env.local untuk kerja lokal, dan isi nilai yang sama di
# Vercel → Project → Settings → Environment Variables untuk produksi.
#
# Semua diawali NEXT_PUBLIC_ karena browser yang memakainya: tautan WhatsApp
# dirender di klien, dan brief dikirim langsung dari browser. Tidak ada rahasia
# di sini — access key Web3Forms memang publik dan terikat ke inbox, bukan ke akun.
#
# PENTING: nilai NEXT_PUBLIC_ dibekukan saat build. Mengubahnya di Vercel tidak
# berpengaruh sampai proyek di-redeploy.

# --- Kontak & lead (wajib, build gagal kalau kosong) ---

# Nomor WhatsApp bisnis. Format 62, tanpa tanda plus, tanpa spasi.
NEXT_PUBLIC_WHATSAPP=6281234567890

# Inbox tujuan formulir brief.
NEXT_PUBLIC_EMAIL=halo@nayba.id

# Access key Web3Forms, terikat ke inbox di atas. Ambil di https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=GANTI-WEB3FORMS-ACCESS-KEY

# --- Situs (opsional) ---

# Host kanonik, tanpa garis miring di akhir. Harus sama dengan domain utama di
# Vercel → Settings → Domains. Kosongkan untuk memakai https://nayba.id.
# NEXT_PUBLIC_SITE_URL=https://nayba.id

# Kota tempat kerja. Kosongkan untuk memakai Yogyakarta.
# NEXT_PUBLIC_KOTA=Yogyakarta

# --- Analitik (opsional) ---
#
# Vercel Web Analytics selalu aktif dan tidak perlu kunci apa pun.
# Isi SALAH SATU di bawah, jangan keduanya — kalau keduanya aktif, tiap
# kunjungan terhitung dua kali.

# GA4 measurement id, bentuknya G-XXXXXXXXXX.
# NEXT_PUBLIC_GA_ID=

# Google Tag Manager container id, bentuknya GTM-XXXXXXX.
# Pakai ini kalau nanti mau menambah Google Ads atau Meta Pixel lewat GTM.
# NEXT_PUBLIC_GTM_ID=

# --- Media sosial (opsional, muncul di JSON-LD sameAs) ---
# NEXT_PUBLIC_INSTAGRAM=
# NEXT_PUBLIC_LINKEDIN=

# --- Build flag ---
#
# Izinkan studi kasus contoh (content/portofolio/contoh-*.mdx) ikut terbit.
# Hapus flag ini begitu portofolio asli tersedia.
IZINKAN_CONTOH=1
